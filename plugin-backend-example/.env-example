# The plugin this backend serves: its tokens' aud must be plugin:{PLUGIN_ID}
PLUGIN_ID=my-plugin
# The core's CORE_PUBLIC_URL, exactly: the issuer of every Plugin token
SOILHIVE_CORE_URL=http://localhost:4001/api/v1
# Optional: where this backend reaches the core, for its keys and its reads, when not at SOILHIVE_CORE_URL
SOILHIVE_CORE_INTERNAL_URL=
PORT=8080
# Optional: the plugin's built remote (its dist folder), served on the same port
STATIC_DIR=
