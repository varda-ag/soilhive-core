# Server settings
CORS_ORIGINS=http://localhost:3000,https://example.com

# Database
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=database
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpass
POSTGRES_SCHEMA=soilhive
# Either define POSTGRES_PASSWORD or POSTGRES_AWS_REGION

# Authorization
## password: superadmin
SUPER_ADMIN_PASSWORD_HASH=$2a$10$OaWUPUR7csoiBYqzp3jq8.s336/WXRvMIWGFluF3BvO/6l/0TYHMq
## password: dataadmin
DATA_ADMIN_PASSWORD_HASH=$2a$10$.oAbT7ZPV75DAhmYTSgW3ucDSFj00wvN/R.bq8.4Y1gL.aQxYAMQ2
SELF_SIGNING_SECRET=put-any-random-string-here
ENTITLEMENTS_ENDPOINT=optional external service providing authorization capabilities
ENTITLEMENTS_CACHE_TTL_MS=optional time in ms a reply of ENTITLEMENTS_ENDPOINT is cached per token (default 1800000, 0 turns the cache off)

# Plugin tokens (docs/adr/0065): leave either unset and none is minted, so a signed-in user's calls to a plugin backend fail with 503 (only anonymous calls go out)
## Secret the Plugin token key is derived from, at least 32 characters (openssl rand -hex 32). Not SELF_SIGNING_SECRET
PLUGIN_TOKEN_SECRET=
## This API's public base URL, the frontend's BACKEND_BASE_URL. Plugin Backends set SOILHIVE_CORE_URL to the same value
CORE_PUBLIC_URL=http://localhost:4001/api/v1
## Optional comma-separated pluginIds whose Plugin tokens keep the user's admin scopes (still read-only)
PLUGIN_TOKEN_ADMIN_PLUGINS=

# Storage
## Mode: local, s3
STORAGE_MODE=local
## Storage specific options
### local
LOCAL_STORAGE_ROOT_FOLDER=/tmp/soilhive-storage
### S3
S3_STORAGE_REGION=
S3_STORAGE_BUCKET=
S3_STORAGE_ROOT_FOLDER=
#### Optional S3 upload config
S3_STORAGE_PART_SIZE_MB=64
S3_STORAGE_QUEUE_SIZE=4
### Maximum size of an uploaded file (POST /files and POST /frontend/logo), in MB
MAX_UPLOAD_SIZE_MB=500
JSON_PAYLOAD_LIMIT=4MB

# Logging
## Minimum log level to emit: debug | info | warn | error (default: info)
LOG_LEVEL=info
## Debug: write all DB queries (with parameters inlined) to /tmp, one .sql file per request
DEBUG_QUERY_LOG=false

# Enables the per-request X-SoilHive-Cache-Bypass header (docs/adr/0028), which
# lets a measurement client observe cold application work without changing the
# deployment. Leave unset/empty and the header does not exist: the cached
# endpoints are unauthenticated, so an ungated bypass would be an amplification
# vector. A client must present this exact value in the header.
CACHE_BYPASS_SECRET=
