        "type": "jsm",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var el = {{Click Element}};\n  el = el && el.closest ? el.closest('[data-analytics]') : null;\n  if (!el) return undefined;\n  if (el.type === 'checkbox') return el.checked ? 'on' : 'off';\n  return el.getAttribute('data-analytics-value') || undefined;\n}"
          }
