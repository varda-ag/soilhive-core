        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var el = {{Click Element}};\n  el = el && el.closest ? el.closest('.p-paginator button') : null;\n  if (!el) return undefined;\n  var c = ' ' + el.className + ' ';\n  if (c.indexOf(' p-paginator-first ') > -1) return 'first';\n  if (c.indexOf(' p-paginator-prev ') > -1) return 'previous';\n  if (c.indexOf(' p-paginator-next ') > -1) return 'next';\n  if (c.indexOf(' p-paginator-last ') > -1) return 'last';\n  return 'page_' + (el.textContent || '').replace(/\\s+/g, '');\n}"
