{
  "name": "soilhive-project",
  "private": true,
  "license": "MIT",
  "version": "1.2.0",
  "description": "",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter=!common --parallel dev",
    "build": "pnpm --filter=!common --parallel build",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "prepare": "husky",
    "soilhive-plugin": "tsx frontend-scripts/soilhive-plugin/index.ts",
    "test:soilhive-plugin-cli": "jest --config frontend-scripts/soilhive-plugin/jest.config.js"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.1",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "prettier": "3.7.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
